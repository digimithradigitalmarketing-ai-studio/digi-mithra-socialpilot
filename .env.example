# Supabase (publishable values - safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (server only). Leave empty to use the built-in template engine.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Server-only secrets for future integrations - never prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# META_APP_ID=
# META_APP_SECRET=

# Contact address for the Enterprise "Contact sales" button
NEXT_PUBLIC_SALES_EMAIL=
