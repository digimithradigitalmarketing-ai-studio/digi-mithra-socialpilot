# Supabase (publishable values - safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (server only). Leave empty to use the built-in template engine.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Server-only secrets for future integrations - never prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# META_APP_ID=
# META_APP_SECRET=

# Contact address for the Enterprise "Contact sales" button
NEXT_PUBLIC_SALES_EMAIL=

# Marketing email (optional). Without a key, sends are simulated and labelled as such.
RESEND_API_KEY=
EMAIL_FROM="Your Brand <hello@yourdomain.com>"

# AI providers. AI_PROVIDER picks the text model ("anthropic" or "gemini"); default = whichever key is set (Claude first).
AI_PROVIDER=
# Gemini (Google AI Studio key). Also required for AI image generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------------------------------------------------------------- Official integrations (server only)
# Supabase service role key: used only by OAuth callbacks, webhooks and the worker. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte key for encrypting provider tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Meta app (Facebook Login for Business, Instagram, Messenger, WhatsApp Cloud API)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Optional: Facebook Login for Business configuration ID (used instead of a scope list)
META_LOGIN_CONFIG_ID=
# Any random string; enter the same value in the Meta app's webhook settings
META_WEBHOOK_VERIFY_TOKEN=
# Google (Business Profile / YouTube / Gmail) — only after Google approves API access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" only after Google OAuth verification for restricted Gmail scopes is complete
GMAIL_ENABLED=false
# Redis for the BullMQ publishing worker (see worker/README.md)
REDIS_URL=
